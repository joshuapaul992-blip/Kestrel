#!/bin/sh
# /usr/share/udhcpc/default.script -- what BusyBox udhcpc runs on each
# DHCP event: it configures the interface with `ip` (netlink), sets the
# default route and writes the name servers. The kernel's own DHCP client
# stops on an interface once its address is changed from user space.
# udhcpc passes: $1 (deconfig, bound, renew, leasefail, nak), $interface,
# $ip, $mask (prefix length), $router, $dns, $domain, $mtu.
RESOLV_CONF=${RESOLV_CONF:-/etc/resolv.conf}

case "$1" in
deconfig)
    ip -4 addr flush dev "$interface"
    ip link set dev "$interface" up
    ;;
bound|renew)
    [ -n "$mtu" ] && ip link set dev "$interface" mtu "$mtu"
    ip -4 addr flush dev "$interface"
    ip addr add "$ip/${mask:-24}" dev "$interface"
    if [ -n "$router" ]; then
        while ip route del default 2>/dev/null; do :; done
        for r in $router; do
            ip route add default via "$r" dev "$interface" && break
        done
    fi
    # /etc/resolv.conf is the kernel's list (/proc/net/pnp) unless it was replaced by a file
    if [ -n "$dns" ] && [ ! -L "$RESOLV_CONF" ]; then
        {
            [ -n "$domain" ] && echo "search $domain"
            for d in $dns; do echo "nameserver $d"; done
        } > "$RESOLV_CONF.$$" && mv "$RESOLV_CONF.$$" "$RESOLV_CONF"
    fi
    ;;
leasefail|nak)
    ;;
esac
exit 0
