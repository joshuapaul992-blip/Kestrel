#!/bin/sh
# /bin/kestrel-selftest -- the GPU self-test, run by GRUB's "GPU self-test"
# entry with no one at the keyboard. It checks the display and OpenGL stack
# step by step and puts what it finds on the stick's "KESTREL RPT" volume:
#
#   RESULTS.TAR   selftest/: summary.txt (PASS/FAIL per check), the system
#                 and GPU reports, the DRM state (/proc/dri) before and after
#                 X, drmtest, the X server's log, xrandr, glxinfo, eglinfo,
#                 glxgears' frame rate, vulkaninfo, vkcube's frame rate,
#                 screenshots (*.xwd.gz) and the kernel log
#   REPORT.TXT    the kernel log and the summary (/dev/report)
#
# Both are rewritten after every step, so a step that hangs the machine
# still leaves the ones before it. The desktop stays up at the end.
# Progress shows on the terminal (and the serial port). The X steps need the Firefox root
# (Xorg, Mesa, its Vulkan drivers and the X client tools); without it they are skipped.
export HOME=/root PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export DISPLAY=:0
D=/tmp/selftest
GEARS_S=${GEARS_S:-30}
CUBE_FRAMES=${CUBE_FRAMES:-600}
mkdir -p $D

say() { echo "selftest: $*"; }                  # the terminal, and the serial port with it
check() {       # check NAME RESULT [DETAIL]
    echo "$2  $1${3:+: $3}" >> $D/summary.txt
    say "$2  $1${3:+: $3}"
}
save() {        # save STEP: the archive and REPORT.TXT, as they stand
    cat /proc/kmsg > $D/kmsg.txt 2>/dev/null
    (cd /tmp && tar -cf /dev/results selftest) 2>/dev/null || say "cannot write RESULTS.TAR"
    { echo "kestrel-selftest, after: $1"; cat $D/summary.txt; } > /dev/report 2>/dev/null
}
shot() {        # shot NAME: the X screen, as xwd's dump, compressed
    xwd -root -silent 2>/dev/null | gzip -1 > $D/$1.xwd.gz && say "screenshot $1"
}

say "start"
: > $D/summary.txt

# 1. the machine and the GPU, as the kernel sees them
{ uname -a; echo; cat /proc/cmdline; echo; cat /proc/cpuinfo | sed -n '1,30p'; echo; cat /proc/meminfo; } > $D/system.txt 2>&1
cat /proc/pci > $D/pci.txt 2>&1
cat /proc/gpu > $D/gpu.txt 2>&1
{ ls -l /dev/dri; for c in /sys/class/drm/*; do echo "$c:"; cat $c/device/uevent 2>/dev/null; done; } > $D/dri-nodes.txt 2>&1
if [ -e /dev/dri/card0 ]; then
    check "a DRM device (/dev/dri/card0)" PASS "$(sed -n 's/^DRIVER=//p' /sys/class/drm/card0/device/uevent 2>/dev/null)"
else
    check "a DRM device (/dev/dri/card0)" FAIL "no Linux display driver took the GPU"
fi
[ -e /dev/dri/renderD128 ] && check "a render node (/dev/dri/renderD128)" PASS || check "a render node (/dev/dri/renderD128)" FAIL
save "the GPU report"

# 2. KMS from a program: Kestrel's own test of the DRM interface
cat /proc/dri > $D/dri-state-boot.txt 2>&1
if [ -x /bin/drmtest ] && [ -e /dev/dri/card0 ]; then
    timeout 120 /bin/drmtest > $D/drmtest.txt 2>&1
    rc=$?
    [ $rc = 0 ] && check "drmtest" PASS || check "drmtest" FAIL "exit $rc, $(grep -c FAIL $D/drmtest.txt) failed"
fi
save "drmtest"

# 3. the X server on the DRM device
if ! command -v Xorg >/dev/null 2>&1 || ! command -v xwd >/dev/null 2>&1; then
    check "the X desktop" SKIP "this root has no Xorg (the Firefox root does)"
    save "done"; say "done"; exit 0
fi
/bin/startx > $D/startx.txt 2>&1 &
i=0; while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 120 ]; do sleep 1; i=$((i + 1)); done
sleep 20                                         # the desktop draws itself
cp /var/log/Xorg.0.log $D/Xorg.0.log 2>/dev/null
if [ -S /tmp/.X11-unix/X0 ] && xrandr --verbose > $D/xrandr.txt 2>&1; then
    check "the X server" PASS "$(grep -c ' connected' $D/xrandr.txt) monitor(s)"
else
    check "the X server" FAIL "no display :0 after ${i}s"
    save "X"; say "done"; exit 1
fi
grep -q "glamor initialized" $D/Xorg.0.log && check "X acceleration (glamor)" PASS || check "X acceleration (glamor)" FAIL "$(grep -m1 'glamor' $D/Xorg.0.log)"
cat /proc/dri > $D/dri-state-x.txt 2>&1
shot desktop
save "the X server"

# 4. OpenGL: the renderer, then glxgears' frame rate
glxinfo -B > $D/glxinfo.txt 2>&1
eglinfo -B > $D/eglinfo.txt 2>&1
r=$(sed -n 's/^OpenGL renderer string: //p' $D/glxinfo.txt)
case "$r" in
    "")                 check "OpenGL (GLX)" FAIL "glxinfo: $(head -1 $D/glxinfo.txt)" ;;
    *llvmpipe*|*softpipe*)
        case "$r" in virgl*) check "OpenGL on the GPU" PASS "$r" ;; *) check "OpenGL on the GPU" FAIL "software rendering: $r" ;; esac ;;
    *)                  check "OpenGL on the GPU" PASS "$r" ;;
esac
save "glxinfo"
vblank_mode=0 timeout $((GEARS_S + 10)) glxgears -info > $D/glxgears.txt 2>&1 &
sleep $((GEARS_S / 2))
shot glxgears
sleep $((GEARS_S / 2))
pkill glxgears 2>/dev/null; sleep 1
fps=$(sed -n 's/.* = \([0-9.]*\) FPS$/\1/p' $D/glxgears.txt | tail -1)
[ -n "$fps" ] && check "glxgears" PASS "$fps FPS (vblank off)" || check "glxgears" FAIL "$(tail -1 $D/glxgears.txt)"
save "glxgears"

# 5. Vulkan: the devices the loader finds, then vkcube on the first GPU
#    (lavapipe, Mesa's software driver, is always there; a GPU is NVK on
#    nouveau, or Venus on virtio-gpu)
if command -v vulkaninfo >/dev/null 2>&1; then
    timeout 120 vulkaninfo --summary > $D/vulkaninfo.txt 2>&1
    timeout 120 vulkaninfo > $D/vulkaninfo-full.txt 2>&1
    # GPUn, deviceType and deviceName of each device, one line each
    awk '/^GPU[0-9]+:/ { n = substr($1, 4) + 0 }
         /deviceType/ { t[n] = $3 } /deviceName/ { sub(/.*= /, ""); d[n] = $0 }
         END { for (i in t) print i, t[i], d[i] }' $D/vulkaninfo.txt | sort -n > $D/vulkan-devices.txt
    gpu=$(grep -v PHYSICAL_DEVICE_TYPE_CPU $D/vulkan-devices.txt | head -1)
    if [ ! -s $D/vulkan-devices.txt ]; then
        check "Vulkan" FAIL "vulkaninfo: $(grep -m1 -i 'error' $D/vulkaninfo.txt)"
    elif [ -n "$gpu" ]; then
        check "Vulkan on the GPU" PASS "${gpu#* * }"
    else
        check "Vulkan on the GPU" FAIL "software only: $(cut -d' ' -f3- $D/vulkan-devices.txt | head -1)"
    fi
    save "vulkaninfo"
    n=${gpu%% *}; n=${n:-0}
    t0=$(date +%s%N)
    timeout 300 vkcube --gpu_number $n --present_mode 0 --c $CUBE_FRAMES > $D/vkcube.txt 2>&1 &
    cube=$!
    sleep 5; shot vkcube
    wait $cube; rc=$?
    ms=$((($(date +%s%N) - t0) / 1000000))
    if [ $rc = 0 ] && [ $ms -gt 0 ]; then
        check "vkcube" PASS "$CUBE_FRAMES frames in $ms ms, $((CUBE_FRAMES * 1000 / ms)) FPS (vsync off), $(sed -n 's/^Selected GPU [0-9]*: //p' $D/vkcube.txt)"
    else
        check "vkcube" FAIL "exit $rc: $(grep -v '^Selected' $D/vkcube.txt | head -1)"
    fi
else
    check "Vulkan" SKIP "this root has no Vulkan drivers"
fi
cat /proc/dri > $D/dri-state-end.txt 2>&1
save "done"
say "done: the results are in RESULTS.TAR and REPORT.TXT on the stick"
wait
